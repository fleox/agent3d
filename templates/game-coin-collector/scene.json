        "id": "over",
        "type": "text",
        "text": "Time's up \u2014 {coins}/{total}",
        "anchor": "center",
        "style": "title",
        "visible": "phase == 'over'"
      },
      {
        "id": "retry",
        "type": "button",
        "text": "Play again",
        "anchor": "bottom",
        "action": "retry",
        "visible": "phase == 'won' || phase == 'over'"
