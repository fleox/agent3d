{
  "version": 1,
  "id": "game-maze",
  "title": "Marble maze",
  "ariaLabel": "Marble maze mini game: roll the ball to the glowing exit with the arrow keys or by holding a finger",
  "seed": 17,
  "target": {"kind": "game", "aspect": "1:1", "budgetKb": 200, "reducedMotion": "ignore", "maxDpr": 2},
  "camera": {"type": "perspective", "fov": 42, "position": [0, 30, 13], "target": [0, 0, 0.8]},
  "environment": {"background": {"radial": ["#2d2a5a", "#14122b"]}, "lighting": "studio", "lightingIntensity": 0.3},
  "lights": [
    {
      "id": "fill",
      "type": "hemisphere",
      "skyColor": "#e9e4ff",
      "groundColor": "#3b2f63",
      "intensity": 0.6
    },
    {"id": "sun", "type": "directional", "position": [-6, 14, 8], "intensity": 1.6, "castShadow": true}
  ],
  "objects": [
    {
      "id": "maze",
      "kind": "generator",
      "generator": "maze",
      "params": {
        "columns": 9,
        "rows": 9,
        "cellSize": 2,
        "wallHeight": 1,
        "wallColor": "#6d5ce8",
        "floorColor": "#d9cdf5",
        "bodies": true
      },
      "receiveShadow": true,
      "castShadow": true
    },
    {
      "id": "floor",
      "kind": "mesh",
      "geometry": {"type": "box", "width": 20, "height": 0.4, "depth": 20},
      "position": [0, -0.2, 0],
      "material": {"preset": "matte", "color": "#e6dcff"},
      "body": {"type": "static"},
      "visible": false
    },
    {
      "id": "ball",
      "kind": "mesh",
      "geometry": {"type": "sphere", "radius": 0.45, "segments": 40, "heightSegments": 28},
      "position": [-8, 0.5, -8],
      "material": {"type": "physical", "color": "#ff5d8f", "roughness": 0.15, "clearcoat": 1, "metalness": 0.1},
      "body": {"type": "dynamic", "shape": "sphere", "radius": 0.45, "restitution": 0.2, "friction": 0.1},
      "castShadow": true,
      "tags": ["player"]
    },
    {
      "id": "goal",
      "kind": "mesh",
      "geometry": {"type": "torus", "radius": 0.6, "tube": 0.12, "radialSegments": 12, "tubularSegments": 48},
      "position": [9.9, 0.8, 8.0],
      "rotation": [0, 0, 0],
      "material": {"preset": "neon", "color": "#4ade80", "emissive": "#4ade80", "emissiveIntensity": 2}
    },
    {
      "id": "goalGlow",
      "kind": "particles",
      "preset": "fireflies",
      "count": 30,
      "area": [1.5, 1.5, 1.5],
      "position": [9.9, 0.8, 8.0],
      "color": "#86efac",
      "size": 0.1
    }
  ],
  "physics": {"gravity": [0, -20, 0]},
  "scripts": ["scripts/maze.js"],
  "data": {"maze": {"accel": 16, "maxSpeed": 6, "damping": 2.2}},
  "ui": {
    "color": "#f5f3ff",
    "accent": "#ff5d8f",
    "elements": [
      {"id": "timeHud", "type": "text", "text": "⏱ {time} s", "anchor": "top-left", "style": "pill"},
      {"id": "bestHud", "type": "text", "text": "Best {best}", "anchor": "top-right", "style": "pill"},
      {
        "id": "title",
        "type": "text",
        "text": "Marble Maze",
        "anchor": "top",
        "style": "title",
        "visible": "phase == 'attract'"
      },
      {
        "id": "hint",
        "type": "text",
        "text": "Arrows / WASD — or hold a finger to roll",
        "anchor": "bottom",
        "style": "subtitle",
        "visible": "phase == 'attract'"
      },
      {
        "id": "won",
        "type": "text",
        "text": "Out in {time} s!",
        "anchor": "center",
        "style": "title",
        "visible": "phase == 'won'"
      },
      {
        "id": "retry",
        "type": "button",
        "text": "Play again",
        "anchor": "bottom",
        "action": "retry",
        "visible": "phase == 'won'"
      }
    ]
  },
  "audio": {"sounds": {"win": {"preset": "win"}, "click": {"preset": "click"}}},
  "postfx": [{"type": "bloom", "strength": 0.6, "radius": 0.4, "threshold": 1.5}]
}
