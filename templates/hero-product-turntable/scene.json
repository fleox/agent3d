    {
      "id": "pedestalRim",
      "kind": "mesh",
      "geometry": {"type": "torus", "radius": 1.47, "tube": 0.018, "radialSegments": 8, "tubularSegments": 160},
      "position": [0, 0.35, 0],
      "rotation": [90, 0, 0],
      "material": {"preset": "gold", "roughness": 0.25}
    },
    {
      "id": "product",
      "kind": "model",
      "src": "library:models/products/boombox.glb",
      "fit": 1.9,
      "position": [0, 0.35, 0],
      "rotation": [0, -20, 0],
      "castShadow": true,
      "receiveShadow": true,
      "behaviours": [{"type": "hoverLift", "height": 0.08, "tilt": 4}]
    }
  ],
  "timeline": {
    "duration": 15,
    "loop": true,
    "tracks": [
      {"target": "product.position.y", "keys": [[0, 0.35], [7.5, 0.42], [15, 0.35]], "ease": "inOutSine"}
    ]
