  "environment": {
    "background": {"radial": ["#f4efe9", "#d9d0c7"]},
    "lighting": {"hdri": "library:hdri/studio.hdr", "intensity": 1},
    "ground": {"y": 0, "size": 20, "shadowOnly": true, "color": "#3b2f25"}
