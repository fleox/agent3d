  "lights": [
    {
      "id": "key",
      "type": "directional",
      "position": [3, 6, 4],
      "intensity": 2.2,
      "castShadow": true,
      "color": "#fff6ec"
    },
    {
      "id": "fill",
      "type": "hemisphere",
      "skyColor": "#ffffff",
      "groundColor": "#c9b8a6",
      "intensity": 0.5
    }
  ],
  "objects": [
    {
      "id": "pedestal",
      "kind": "mesh",
      "geometry": {"type": "cylinder", "radiusTop": 1.45, "radiusBottom": 1.5, "height": 0.35, "segments": 96},
      "position": [0, 0.175, 0],
      "material": {"preset": "clay", "color": "#efe6dc", "roughness": 0.65},
      "castShadow": true,
      "receiveShadow": true
