{
  "version": 1,
  "id": "hero-product-turntable",
  "title": "Product turntable hero",
  "ariaLabel": "A retro boombox turning slowly on a studio pedestal",
  "seed": 1,
  "target": {
    "kind": "hero",
    "aspect": "16:9",
    "budgetKb": 1200,
    "reducedMotion": "static",
    "posterTime": 0,
    "maxDpr": 2,
    "toneMapping": "neutral",
    "exposure": 1
  },
  "camera": {
    "type": "perspective",
    "fov": 32,
    "position": [0, 1.6, 6.2],
    "target": [0, 0.75, 0],
